# Animal Puzzle Reels Factory — Environment Configuration Template
# Never commit real credentials, session cookies, or private tokens to Git.

DATABASE_URL=postgresql://puzzle_admin:change_me_local_only@localhost:5432/animal_puzzle_factory
SQLITE_DB_PATH=./storage/factory.db
DEFAULT_TIMEZONE=Africa/Casablanca

# Rendering & Worker Configuration
WORKER_CONCURRENCY=2
DEFAULT_RESOLUTION=1080x1920
DEFAULT_FPS=30
DEFAULT_DURATION_SEC=15.0

# Facebook Publishing Safety Switches (DISABLED BY DEFAULT)
BROWSER_AUTOMATION_ENABLED=false
LIVE_PUBLISH_ENABLED=false
MAX_DAILY_POSTS_PER_PAGE=2
QUIET_HOURS_START=23:00
QUIET_HOURS_END=07:00
CHROMIUM_USER_DATA_ROOT=./storage/browser_profiles

# Optional Paid AI Asset Providers (System runs 100% offline when omitted)
IMAGE_PROVIDER=offline_procedural
OPENAI_API_KEY=
STABILITY_API_KEY=
